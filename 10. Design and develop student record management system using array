import java.util.*;

public class StudentRecordManagement {
    public static void main(String[] args) {

        ArrayList<String> students = new ArrayList<>();

        students.add("Arun");
        students.add("Bala");
        students.add("Cathy");

        System.out.println("Student Records:");
        for (String name : students) {
            System.out.println(name);
        }

        HashMap<Integer, String> studentMap = new HashMap<>();

        studentMap.put(101, "Arun");
        studentMap.put(102, "Bala");
        studentMap.put(103, "Cathy");

        // Add
        studentMap.put(104, "David");

        // Search
        System.out.println("\nStudent with ID 102: "
                + studentMap.get(102));

        // Update
        studentMap.put(102, "Bala Kumar");

        // Delete
        studentMap.remove(103);

        // Display
        System.out.println("\nUpdated Student Records:");

        for (Map.Entry<Integer, String> entry : studentMap.entrySet()) {
            System.out.println(
                "ID: " + entry.getKey() +
                ", Name: " + entry.getValue()
            );
        }
    }
}
